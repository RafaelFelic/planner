{
	"name": "planner",
	"version": "2.0.0",
	"description": "Planner with tasks, schedule, notes, weather and live markets",
	"private": true,
	"type": "module",
	"author": "Rafael Feliciano",
	"license": "ISC",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
